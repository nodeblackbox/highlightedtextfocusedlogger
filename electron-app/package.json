{
  "name": "highlight-reader",
  "version": "0.1.0",
  "private": true,
  "description": "Highlight any text on your PC, press Alt+R, hear it read aloud via Edge TTS.",
  "main": "dist/main.js",
  "scripts": {
    "build:helper": "dotnet build -c Release selection-helper/SelectionHelper.csproj",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/index.html','dist/index.html')\"",
    "start": "npm run build:helper && npm run build && electron .",
    "dev": "npm run build && electron ."
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "electron": "^33.2.1",
    "typescript": "^5.7.2"
  }
}
